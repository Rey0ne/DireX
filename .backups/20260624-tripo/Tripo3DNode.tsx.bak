/* === Tripo3DNode — AI 3D模型生成节点 === */
import { useState, useCallback, useRef, useEffect } from 'react';
import { Handle, Position, useStore } from '@xyflow/react';
import { useCanvasStore } from '../../store/useCanvasStore';
import { TripoModelPreview } from '../TripoModelPreview';

// ─── Types ───────────────────────────────────────
interface TripoNodeData {
  prompt?: string;
  inputImageUrl?: string;
  mode?: 'text-to-model' | 'image-to-model';
  modelVersion?: string;
  modelSeries?: 'H' | 'P';
  texture?: boolean;
  pbr?: boolean;
  textureQuality?: 'standard' | 'detailed' | 'extreme';
  geometryQuality?: 'standard' | 'detailed';
  faceLimit?: number;
  autoSize?: boolean;
  compress?: boolean;
  // Result
  taskId?: string;
  status?: 'idle' | 'generating' | 'done' | 'expired';
  progress?: number;
  modelUrl?: string;
  renderedImageUrl?: string;
  savedPath?: string;
  savedName?: string;
  savedSize?: number;
  creditsConsumed?: number;
  error?: string;
}

const H_MODELS = [
  { value: 'v3.1-20260211', label: 'v3.1 (最新)' },
  { value: 'v3.0-20250812', label: 'v3.0 (稳定)' },
  { value: 'v2.5-20250123', label: 'v2.5 (均衡)' },
];
const P_MODELS = [
  { value: 'P1-20260311', label: 'P1 (低面数)' },
];

const QUALITY_OPTIONS = [
  { value: 'standard', label: '标准' },
  { value: 'detailed', label: '高精度' },
  { value: 'extreme', label: '极致 8K' },
];

// ─── Component ────────────────────────────────────
export function Tripo3DNode({ id, data }: { id: string; data: TripoNodeData }) {
  const [expanded, setExpanded] = useState(false);
  const [showPreview, setShowPreview] = useState(false);
  const [paramsOpen, setParamsOpen] = useState(false);
  const fileRef = useRef<HTMLInputElement>(null);

  const [prompt, setPrompt] = useState(data.prompt || '');
  const [mode, setMode] = useState<'text-to-model' | 'image-to-model'>(data.mode || 'text-to-model');
  const [series, setSeries] = useState<'H' | 'P'>(data.modelSeries || 'P');
  const [modelVer, setModelVer] = useState(data.modelVersion || 'P1-20260311');
  const [texture, setTexture] = useState(data.texture !== false);
  const [pbr, setPbr] = useState(data.pbr !== false);
  const [texQuality, setTexQuality] = useState(data.textureQuality || 'standard');
  const [faceLimit, setFaceLimit] = useState(data.faceLimit || 50000);
  const [autoSize, setAutoSize] = useState(data.autoSize || false);
  const [compress, setCompress] = useState(data.compress || false);
  const [status, setStatus] = useState(data.status || 'idle');
  const [progress, setProgress] = useState(data.progress || 0);
  const [taskId, setTaskId] = useState(data.taskId || '');
  const [modelUrl, setModelUrl] = useState(data.modelUrl || '');
  const [renderedUrl, setRenderedUrl] = useState(data.renderedImageUrl || '');
  const [savedPath, setSavedPath] = useState(data.savedPath || '');
  const [savedName, setSavedName] = useState(data.savedName || '');
  const [savedSize, setSavedSize] = useState(data.savedSize || 0);
  const [credits, setCredits] = useState(data.creditsConsumed || 0);
  const [error, setError] = useState(data.error || '');
  const [inputImage, setInputImage] = useState(data.inputImageUrl || '');
  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);

  // Read incoming edge data from canvas store
  const connectedImage = useStore((s) => {
    const store = useCanvasStore.getState();
    for (const e of s.edges) {
      if (e.target === id && e.targetHandle === 'image-in') {
        const sourceNode = store.nodes.get(e.source);
        const m = sourceNode?.meta as any;
        if (m?.gen?.imageUrl) return m.gen.imageUrl as string;
        if (m?.imageUrl) return m.imageUrl as string;
      }
    }
    return '';
  });
  const connectedPrompt = useStore((s) => {
    const store = useCanvasStore.getState();
    for (const e of s.edges) {
      if (e.target === id && e.targetHandle === 'prompt-in') {
        const sourceNode = store.nodes.get(e.source);
        const m = sourceNode?.meta as any;
        if (m?.shot?.intent_cn) return m.shot.intent_cn as string;
        if (m?.gen?.prompt) return m.gen.prompt as string;
      }
    }
    return '';
  });

  useEffect(() => {
    if (connectedImage && !inputImage) setInputImage(connectedImage);
    if (connectedPrompt && !prompt) setPrompt(connectedPrompt);
  }, [connectedImage, connectedPrompt]);

  const effectivePrompt = prompt || connectedPrompt;
  const effectiveInput = inputImage || connectedImage;

  // Cleanup
  useEffect(() => () => { if (pollingRef.current) clearInterval(pollingRef.current); }, []);

  // ─── Generate ────────────────────────────────────
  const handleGenerate = useCallback(async () => {
    setStatus('generating'); setProgress(0); setError(''); setSavedPath(''); setSavedName('');

    try {
      const body: Record<string, unknown> = {
        mode: effectiveInput ? 'image-to-model' : 'text-to-model',
        model: modelVer, texture, pbr, texture_quality: texQuality,
        face_limit: faceLimit, auto_size: autoSize,
      };
      if (effectivePrompt) body.prompt = effectivePrompt;
      if (effectiveInput) body.input = effectiveInput;
      if (compress) body.compress = 'geometry';

      const resp = await fetch('/api/tripo/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const json = await resp.json();
      if (!json.success) { setStatus('idle'); setError(json.error || 'Failed'); return; }

      const tid = json.task_id;
      setTaskId(tid);
      setProgress(5);

      pollingRef.current = setInterval(async () => {
        try {
          const pr = await fetch(`/api/tripo/task/${tid}`);
          const pj = await pr.json();
          setProgress(pj.progress || 0);
          if (pj.status === 'success') {
            if (pollingRef.current) clearInterval(pollingRef.current);
            pollingRef.current = null;
            setModelUrl(pj.output?.model_url || '');
            setRenderedUrl(pj.output?.rendered_image_url || '');
            setCredits(pj.credits_consumed || 0);
            setStatus('done'); setProgress(100);
          } else if (['failed','cancelled','banned','expired'].includes(pj.status)) {
            if (pollingRef.current) clearInterval(pollingRef.current);
            pollingRef.current = null;
            setStatus('idle');
            setError(pj.error || `任务${pj.status}`);
          }
        } catch { /* retry next poll */ }
      }, 2000);
    } catch (e: any) {
      setStatus('idle');
      setError(String(e).slice(0, 200));
    }
  }, [effectivePrompt, effectiveInput, modelVer, texture, pbr, texQuality, faceLimit, autoSize, compress]);

  // ─── Save Model ──────────────────────────────────
  const handleSave = useCallback(async () => {
    if (!modelUrl) return;
    try {
      const name = effectivePrompt?.slice(0,30).replace(/[^a-zA-Z0-9一-鿿]/g,'_')||'tripo_model';
      const resp = await fetch('/api/tripo/save-model', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ model_url: modelUrl, name }),
      });
      const json = await resp.json();
      if (json.success) { setSavedPath(json.path); setSavedName(json.name); setSavedSize(json.size); }
      else { setError(json.error || 'Save failed'); }
    } catch (e: any) { setError(String(e).slice(0,200)); }
  }, [modelUrl, effectivePrompt]);

  // ─── Upload image ────────────────────────────
  const handleImageUpload = useCallback(async (file: File) => {
    const fd = new FormData(); fd.append('model', file);
    try {
      const resp = await fetch('/api/models/upload', { method:'POST', body:fd });
      const json = await resp.json();
      if (json.success) { setInputImage(json.path); setMode('image-to-model'); }
    } catch { setError('上传失败'); }
  }, []);

  // ─── Persist to canvas store ─────────────────
  useEffect(() => {
    const store = useCanvasStore.getState();
    const node = store.nodes.get(id);
    if (node) {
      store.updateNode(id, { meta: {
        prompt: effectivePrompt, inputImageUrl: inputImage,
        mode, modelVersion: modelVer, modelSeries: series,
        texture, pbr, textureQuality: texQuality, faceLimit, autoSize, compress,
        taskId, status, progress, modelUrl, renderedImageUrl: renderedUrl,
        savedPath, savedName, savedSize, creditsConsumed: credits, error,
      }});
    }
  }, [effectivePrompt, inputImage, mode, modelVer, series, texture, pbr, texQuality, faceLimit, autoSize, compress, taskId, status, progress, modelUrl, renderedUrl, savedName, savedPath, credits]);

  // ─── Countdown ───────────────────────────────
  const [remaining, setRemaining] = useState(300);
  useEffect(() => {
    if (status !== 'done' || savedPath) return;
    const start = Date.now();
    const iv = setInterval(() => {
      const left = Math.max(0, 300 - Math.floor((Date.now()-start)/1000));
      setRemaining(left);
      if (left <= 0) { setStatus('expired'); clearInterval(iv); }
    }, 1000);
    return () => clearInterval(iv);
  }, [status, savedPath, modelUrl]);

  const isSaved = !!savedPath;
  const outputLocked = !isSaved && status === 'done';
  const outputActive = isSaved;

  return (
    <>
      <div style={{
        width: 360, background: '#1a1a1e', borderRadius: 12,
        border: '1px solid rgba(255,255,255,0.06)',
        display: 'flex', flexDirection: 'column',
        fontFamily: 'Inter, system-ui, sans-serif',
        boxShadow: '0 4px 24px rgba(0,0,0,0.4)',
      }}>
        {/* Header */}
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', padding:'10px 14px', borderBottom:'1px solid rgba(255,255,255,0.05)' }}>
          <div style={{ display:'flex', alignItems:'center', gap:8 }}>
            <span style={{ fontSize:16 }}>🧊</span>
            <span style={{ color:'#fff', fontSize:13, fontWeight:600 }}>AI 建模</span>
            {status==='generating' && <span style={{ width:8,height:8,borderRadius:'50%',background:'#f59e0b' }} />}
            {status==='done' && !isSaved && <span style={{ width:8,height:8,borderRadius:'50%',background:'#ef4444' }} />}
            {isSaved && <span style={{ width:8,height:8,borderRadius:'50%',background:'#22c55e' }} />}
          </div>
          <button onClick={() => setExpanded(!expanded)} style={{ background:'none',border:'none',color:'#888',cursor:'pointer',fontSize:12 }}>{expanded?'−':'+'}</button>
        </div>

        {!expanded && (<>
          {/* Input */}
          <div style={{ padding:'10px 14px', display:'flex', flexDirection:'column', gap:8 }}>
            <div style={{ display:'flex', gap:6, alignItems:'center' }}>
              <select value={mode} onChange={e => setMode(e.target.value as any)}
                style={{ background:'#222',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:6,padding:'4px 8px',fontSize:11,cursor:'pointer' }}>
                <option value="text-to-model">文本→3D</option>
                <option value="image-to-model">图片→3D</option>
              </select>
              <select value={series} onChange={e => { const v=e.target.value as'H'|'P';setSeries(v);setModelVer(v==='P'?'P1-20260311':'v3.1-20260211'); }}
                style={{ background:'#222',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:6,padding:'4px 8px',fontSize:11,cursor:'pointer' }}>
                <option value="P">P 系列</option>
                <option value="H">H 系列</option>
              </select>
              <select value={modelVer} onChange={e => setModelVer(e.target.value)}
                style={{ background:'#222',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:6,padding:'4px 8px',fontSize:11,cursor:'pointer' }}>
                {(series==='P'?P_MODELS:H_MODELS).map(m => <option key={m.value} value={m.value}>{m.label}</option>)}
              </select>
            </div>
            {series==='H' && <div style={{ fontSize:10,color:'#f59e0b',background:'rgba(245,158,11,0.08)',padding:'4px 8px',borderRadius:4 }}>⚠ H系列面数较高，3D世界暂不支持直接导入</div>}
            {mode==='text-to-model' && <textarea value={prompt} onChange={e => setPrompt(e.target.value)} placeholder={connectedPrompt?'已从连线接收...':'输入提示词...'} rows={3}
              style={{ width:'100%',background:'#111',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:6,padding:'8px 10px',fontSize:12,resize:'vertical',fontFamily:'inherit',outline:'none' }} />}
            {mode==='image-to-model' && <div style={{ display:'flex',gap:8,alignItems:'center' }}>
              <button onClick={() => fileRef.current?.click()}
                style={{ padding:'6px 12px',borderRadius:6,border:'1px dashed rgba(255,255,255,0.15)',background:'rgba(255,255,255,0.03)',color:'#aaa',cursor:'pointer',fontSize:11 }}>
                {effectiveInput?'换图':'上传图片'}
              </button>
              {effectiveInput && <img src={effectiveInput} alt="ref" style={{ width:48,height:48,borderRadius:4,objectFit:'cover',border:'1px solid rgba(255,255,255,0.08)' }} />}
              <input ref={fileRef} type="file" accept="image/png,image/jpeg,image/webp" style={{ display:'none' }}
                onChange={e => { const f=e.target.files?.[0]; if(f){ handleImageUpload(f); e.target.value=''; } }} />
            </div>}
          </div>

          {/* Advanced params */}
          <div style={{ padding:'0 14px' }}>
            <button onClick={() => setParamsOpen(!paramsOpen)} style={{ background:'none',border:'none',color:'#888',cursor:'pointer',fontSize:11,padding:'4px 0',display:'flex',alignItems:'center',gap:4 }}>
              <span>{paramsOpen?'▾':'▸'}</span> 高级参数
            </button>
            {paramsOpen && <div style={{ display:'flex',flexDirection:'column',gap:6,paddingBottom:8 }}>
              <div style={{ display:'flex',gap:10,alignItems:'center',fontSize:11,color:'#aaa' }}>
                <label style={{ display:'flex',alignItems:'center',gap:4,cursor:'pointer' }}><input type="checkbox" checked={texture} onChange={e => setTexture(e.target.checked)} /> 贴图</label>
                <label style={{ display:'flex',alignItems:'center',gap:4,cursor:'pointer' }}><input type="checkbox" checked={pbr} onChange={e => setPbr(e.target.checked)} disabled={!texture} /> PBR</label>
                <select value={texQuality} onChange={e => setTexQuality(e.target.value as any)}
                  style={{ background:'#222',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:4,padding:'2px 6px',fontSize:10 }}>
                  {QUALITY_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                </select>
              </div>
              <div style={{ display:'flex',gap:10,alignItems:'center',fontSize:11,color:'#aaa' }}>
                <span>面数:</span>
                <input type="number" value={faceLimit} onChange={e => setFaceLimit(Number(e.target.value))}
                  style={{ width:70,background:'#111',color:'#fff',border:'1px solid rgba(255,255,255,0.08)',borderRadius:4,padding:'2px 6px',fontSize:11 }} />
                <label style={{ display:'flex',alignItems:'center',gap:4,cursor:'pointer' }}><input type="checkbox" checked={autoSize} onChange={e => setAutoSize(e.target.checked)} /> 自动尺寸</label>
                <label style={{ display:'flex',alignItems:'center',gap:4,cursor:'pointer' }}><input type="checkbox" checked={compress} onChange={e => setCompress(e.target.checked)} /> 压缩</label>
              </div>
            </div>}
          </div>

          {/* Generate / Progress */}
          <div style={{ padding:'6px 14px',display:'flex',flexDirection:'column',gap:6 }}>
            {status==='generating' ? (<>
              <div style={{ height:4,background:'rgba(255,255,255,0.06)',borderRadius:2,overflow:'hidden' }}>
                <div style={{ height:'100%',width:`${progress}%`,background:'linear-gradient(90deg,#5EEAD4,#3b82f6)',borderRadius:2,transition:'width 0.3s' }} />
              </div>
              <div style={{ display:'flex',justifyContent:'space-between',fontSize:10,color:'#888' }}><span>生成中...</span><span>{progress}%</span></div>
            </>) : status==='idle' ? (
              <button onClick={handleGenerate} disabled={!effectivePrompt && !effectiveInput}
                style={{ width:'100%',padding:'8px 0',borderRadius:6,border:'none',
                  background:(effectivePrompt||effectiveInput)?'#5EEAD4':'rgba(255,255,255,0.06)',
                  color:(effectivePrompt||effectiveInput)?'#000':'#555',
                  cursor:(effectivePrompt||effectiveInput)?'pointer':'not-allowed',fontSize:13,fontWeight:700 }}>▶ 生成</button>
            ) : null}
            {error && <div style={{ fontSize:10,color:'#ef4444' }}>{error}</div>}
          </div>

          {/* Result */}
          {(status==='done'||status==='expired') && <div style={{ padding:'8px 14px',borderTop:'1px solid rgba(255,255,255,0.05)',display:'flex',flexDirection:'column',gap:8 }}>
            {renderedUrl && <div style={{ position:'relative' }}>
              <img src={renderedUrl} alt="preview" onClick={() => setShowPreview(true)}
                style={{ width:'100%',height:120,objectFit:'cover',borderRadius:8,border:'1px solid rgba(255,255,255,0.08)',cursor:'pointer' }} />
              <div style={{ position:'absolute',bottom:6,right:6,background:'rgba(0,0,0,0.6)',color:'#fff',fontSize:10,padding:'2px 8px',borderRadius:4,pointerEvents:'none' }}>🔍 点击预览</div>
            </div>}
            {!isSaved && status==='done' && <div style={{ fontSize:10,color:'#ef4444',background:'rgba(239,68,68,0.08)',padding:'6px 8px',borderRadius:4 }}>
              ⚠ 链接{Math.floor(remaining/60)}分{remaining%60}秒后过期，请立即保存！</div>}
            {isSaved && <div style={{ fontSize:10,color:'#22c55e',background:'rgba(34,197,94,0.08)',padding:'6px 8px',borderRadius:4 }}>
              ✅ 已保存 · {savedName} · {(savedSize/1024).toFixed(1)} KB</div>}
            <div style={{ display:'flex',gap:6 }}>
              {!isSaved && status==='done' && <button onClick={handleSave}
                style={{ flex:1,padding:'6px 0',borderRadius:6,border:'none',background:'#ef4444',color:'#fff',cursor:'pointer',fontSize:12,fontWeight:700 }}>💾 保存到模型库</button>}
              {isSaved && <button onClick={() => setShowPreview(true)}
                style={{ flex:1,padding:'6px 0',borderRadius:6,border:'1px solid rgba(94,234,212,0.2)',background:'rgba(94,234,212,0.08)',color:'#5EEAD4',cursor:'pointer',fontSize:12,fontWeight:600 }}>🔍 3D 预览</button>}
            </div>
            {credits>0 && <div style={{ fontSize:10,color:'#666',textAlign:'right' }}>消耗 {credits} 积分</div>}
          </div>}
        </>)}
      </div>

      {/* Handles */}
      <Handle type="target" position={Position.Left} id="prompt-in"
        style={{ top:'25%',width:10,height:10,background:'#8b5cf6',border:'2px solid #1a1a1e',borderRadius:'50%' }} />
      <Handle type="target" position={Position.Left} id="image-in"
        style={{ top:'55%',width:10,height:10,background:'#3b82f6',border:'2px solid #1a1a1e',borderRadius:'50%' }} />
      <Handle type="source" position={Position.Right} id="model-out"
        style={{ top:'50%',width:12,height:12,
          background: outputActive?'#22c55e':outputLocked?'rgba(239,68,68,0.5)':'#666',
          border:`2px solid ${outputActive?'#166534':outputLocked?'rgba(127,29,29,0.5)':'#333'}`,
          borderRadius:'50%',cursor:outputLocked?'not-allowed':'pointer' }} />

      {/* Preview */}
      {showPreview && (modelUrl||savedPath) && <TripoModelPreview
        modelUrl={savedPath?`/api${savedPath}`:modelUrl}
        modelName={savedName||effectivePrompt?.slice(0,20)||'模型'}
        onClose={() => setShowPreview(false)} />}
    </>
  );
}
