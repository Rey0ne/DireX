"visualBible\": {\n    \"colorPalette\": \"雪原段以银白、血红、毒黑为主；现代公寓段以暖黄、米色与豹纹艳色制造虚假日常感；森林段以月光蓝、暗金、血红与幽蓝图腾光为主。\",\n    \"lightingStyle\": \"高反差奇幻现实风格，雪原使用冷硬自然光与风雪漫反射，公寓使用日间室内自然光和蜡烛扭曲光影，森林使用强月光、雾气逆光与超自然发光纹路。\",\n    \"era\": \"现代都市与古老狼人族群并存的奇幻现代背景。\"\n  },\n  \"characterProfiles\": {\n    \"苏尔里女王\": {\n      \"role\": \"主角\",\n      \"appearance\": \"小贝拉的母亲，苏尔里狼族女王，白色狼毛大氅，金色王冠，红瞳，清冷高贵，化狼后为银色巨狼。\"\n    },\n    \"小贝拉\": {\n      \"role\": \"主角\",\n      \"appearance\": \"幼年时期的辛德瑞拉，苏尔里狼族最后的公主，穿红色斗篷，脖子戴狼头吊坠，稚弱惊恐。\"\n    },\n    \"辛德瑞拉\": {\n      \"role\": \"主角\",\n      \"appearance\": \"长大后的贝拉，被人类奶奶救起后取名辛德瑞拉，失忆且失明，佩戴狼头吊坠；在公寓段穿甜品店制服或米色碎花长裙加围裙，柔弱善良。\"\n    },\n    \"卡迪亚\": {\n      \"role\": \"反派\",\n      \"appearance\": \"叛徒狼族，光着带伤疤的上半身，穿缀有灰黑色狼毛的铆钉裤子，蓝瞳，古铜色皮肤伤疤渗出黑色血雾，化狼后为体型庞大的纯黑色狼。\"\n    },\n    \"苏尔里女王的6名随从\": {\n      \"role\": \"群演\",\n      \"appearance\": \"女王的女性狼族护卫，紧身浅色皮衣和棉服，口袋或领口缀银白色狼毛，三名白人女性、三名黑人女性，黑瞳，忠诚视死如归，化狼后为银狼。\"\n    },\n    \"卡迪亚的8名手下\": {\n      \"role\": \"群演\",\n      \"appearance\": \"卡迪亚狼群男性手下，清一色古铜皮肤，黑色夹克和棉服，灰黑色狼毛耳罩与毛领，黑瞳，吊儿郎当又狂妄，化狼后为黑狼群。\"\n    },\n    \"王室狼族战死者\": {\n      \"role\": \"群演\",\n      \"appearance\": \"战死的王室狼族，雪原上以被利箭射中、倒在染血雪地里的狼尸出现，象征女王族群的惨烈牺牲。\"\n    },\n    \"莱斯特\": {\n      \"role\": \"反派\",\n      \"appearance\": \"辛德瑞拉的人类未婚夫，公寓段穿西装套装或牛仔裤，森林段穿绿色格子衬衣和牛仔裤，虚伪、猥琐、残忍。\"\n    },\n    \"布蕾克\": {\n      \"role\": \"反派\",\n      \"appearance\": \"辛德瑞拉的妹妹或表妹，奶奶的孙女，穿豹纹紧身露臀吊带裙，黑色卷发，挑衅狠毒，怀有莱斯特的孩子。\"\n    },\n    \"布蕾克腹中的孩子\": {\n      \"role\": \"配角\",\n      \"appearance\": \"布蕾克宣称已经怀上的莱斯特的孩子，未出场但作为背叛与婚约取代的关键剧情信息存在。\"\n    },\n    \"奶奶\": {\n      \"role\": \"配角\",\n      \"appearance\": \"十八年前从山谷里捡回辛德瑞拉的人类奶奶，未直接出场，被旁白和故事脉络提及，是辛德瑞拉在人类世界身份的来源。\"\n    },\n    \"阿瑞斯\": {\n      \"role\": \"主角\",\n      \"appearance\": \"巨狼化身的男性狼人，裸露健美精壮上身，下身穿装饰有兽皮金属皮具的黑色牛仔裤；化狼时体型为普通狼三倍，暗金色毛发流淌金色流光，化人后蜜色肌肉、背部幽蓝图腾纹路，胸口戴与辛德瑞拉一样的狼头吊坠。\"\n    },\n    \"森林头狼\": {\n      \"role\": \"群演\",\n      \"appearance\": \"森林七匹野狼中最大的头狼，灰黑色毛发，蓝色眼睛，獠牙在月光下泛冷光，流着涎液，率先扑咬辛德瑞拉。\"\n    },\n    \"森林野狼群其余6只\": {\n      \"role\": \"群演\",\n      \"appearance\": \"森林马路边被血腥味引来的六只灰黑色野狼，蓝色眼睛如鬼火，龇牙咧嘴包抄辛德瑞拉，后被阿瑞斯震慑后夹尾匍匐。\"\n    }\n  }\n}",
                "durationMs": 54274
              }
            ],
            "totalDurationMs": 72563,
            "totalScenes": 4
          }
        }
      }
    },
