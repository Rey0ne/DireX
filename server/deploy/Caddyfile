# DireX — Caddy reverse proxy with auto HTTPS
# Replace api.direx.example.com with your actual domain

api.direx.example.com {
    reverse_proxy localhost:3001

    # Allow large uploads (3D models up to 200MB)
    request_body {
        max_size 200MB
    }

    # Logging
    log {
        output file /var/log/caddy/direx.log
    }
}
